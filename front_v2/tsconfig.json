{
  "compilerOptions": {
    "removeComments": true,
    "target": "esnext",
    "baseUrl": ".",
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@shared/*": ["src/shared/*"],
      "@entities/*": ["src/entities/*"],
      "@features/*": ["src/features/*"],
      "@widgets/*": ["src/widgets/*"],
      "@page/*": ["./src/page/*"],
      "@tool/*": ["./src/tool/*"],
      "@store/*": ["src/entities/store/*"],
      "@socket/*": ["src/shared/api/socket/*"],
      "@font/*": ["./public/fonts/*"]
    }
  },
  "include": ["src/**/*"]
}
